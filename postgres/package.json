{
	"name": "@absolutejs/queue-postgres",
	"version": "0.0.3",
	"description": "Postgres (Drizzle) storage adapter for @absolutejs/queue",
	"repository": {
		"type": "git",
		"url": "https://github.com/absolutejs/queue-adapters.git",
		"directory": "postgres"
	},
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"license": "CC BY-NC 4.0",
	"author": "Alex Kahn",
	"publishConfig": {
		"access": "public"
	},
	"keywords": [
		"queue",
		"jobs",
		"postgres",
		"drizzle",
		"absolutejs",
		"bun"
	],
	"scripts": {
		"build": "rm -rf dist && bun build src/index.ts --outdir dist --sourcemap --target=bun --external drizzle-orm --external postgres --external @absolutejs/queue && tsc --project tsconfig.build.json",
		"test": "bun test",
		"test:pg": "QUEUE_TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55444/queue_test bun test",
		"pg:start": "sh -lc 'docker start absolutejs-queue-test-pg >/dev/null 2>&1 || docker run -d --name absolutejs-queue-test-pg -e POSTGRES_PASSWORD=postgres -e POSTGRES_USER=postgres -e POSTGRES_DB=queue_test -p 55444:5432 postgres:15 >/dev/null'",
		"pg:stop": "sh -lc 'docker rm -f absolutejs-queue-test-pg >/dev/null 2>&1 || true'",
		"typecheck": "tsc --noEmit",
		"format": "prettier --write \"./**/*.{ts,json,md}\"",
		"release": "bun run format && bun run build && bun publish"
	},
	"dependencies": {
		"@absolutejs/queue": "^0.0.3"
	},
	"peerDependencies": {
		"drizzle-orm": ">= 0.40.0",
		"postgres": ">= 3.4.0"
	},
	"devDependencies": {
		"@types/bun": "1.2.9",
		"drizzle-orm": "0.45.2",
		"postgres": "3.4.9",
		"prettier": "3.5.3",
		"typescript": "5.8.3"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md"
	]
}
