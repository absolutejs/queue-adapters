{
	"name": "@absolutejs/queue-postgres",
	"version": "0.1.0",
	"description": "Postgres (Drizzle) storage adapter for @absolutejs/queue — postgres.js + Neon serverless",
	"repository": {
		"type": "git",
		"url": "https://github.com/absolutejs/queue-adapters.git",
		"directory": "postgres"
	},
	"homepage": "https://github.com/absolutejs/queue-adapters/tree/main/postgres",
	"bugs": {
		"url": "https://github.com/absolutejs/queue-adapters/issues"
	},
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"license": "Apache-2.0",
	"author": "Alex Kahn",
	"publishConfig": {
		"access": "public"
	},
	"keywords": [
		"queue",
		"jobs",
		"postgres",
		"neon",
		"drizzle",
		"absolutejs",
		"bun"
	],
	"scripts": {
		"build": "rm -rf dist && bun build src/index.ts src/postgresJobStore.ts src/neonJobStore.ts --outdir dist --sourcemap --target=bun --external drizzle-orm --external postgres --external @neondatabase/serverless --external @absolutejs/queue && tsc --project tsconfig.build.json",
		"test": "bun test",
		"test:pg": "QUEUE_TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55444/queue_test bun test",
		"pg:start": "sh -lc 'docker start absolutejs-queue-test-pg >/dev/null 2>&1 || docker run -d --name absolutejs-queue-test-pg -e POSTGRES_PASSWORD=postgres -e POSTGRES_USER=postgres -e POSTGRES_DB=queue_test -p 55444:5432 postgres:15 >/dev/null'",
		"pg:stop": "sh -lc 'docker rm -f absolutejs-queue-test-pg >/dev/null 2>&1 || true'",
		"typecheck": "tsc --noEmit",
		"format": "prettier --write \"./**/*.{ts,json,md}\"",
		"release": "bun run format && bun run build && bun publish"
	},
	"peerDependencies": {
		"@absolutejs/queue": ">= 0.1.0",
		"@neondatabase/serverless": ">= 0.10.0",
		"drizzle-orm": ">=1.0.0-rc.1",
		"postgres": ">= 3.4.0"
	},
	"peerDependenciesMeta": {
		"@neondatabase/serverless": {
			"optional": true
		},
		"postgres": {
			"optional": true
		}
	},
	"devDependencies": {
		"@absolutejs/queue": "^0.1.0",
		"@neondatabase/serverless": "^0.10.0",
		"@types/bun": "1.2.9",
		"drizzle-orm": "1.0.0-rc.3",
		"postgres": "3.4.9",
		"prettier": "3.5.3",
		"typescript": "5.8.3"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./postgres": {
			"types": "./dist/postgresJobStore.d.ts",
			"import": "./dist/postgresJobStore.js",
			"default": "./dist/postgresJobStore.js"
		},
		"./neon": {
			"types": "./dist/neonJobStore.d.ts",
			"import": "./dist/neonJobStore.js",
			"default": "./dist/neonJobStore.js"
		}
	},
	"files": [
		"dist",
		"README.md"
	]
}
