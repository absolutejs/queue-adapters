{
  "name": "@absolutejs/queue-redis",
  "version": "0.0.3",
  "description": "Redis-backed JobStore for @absolutejs/queue. Atomic Lua claim, sorted-set scheduling by runAt, per-job hash records. For shops running Redis instead of (or alongside) Postgres.",
  "repository": {
    "type": "git",
    "url": "https://github.com/absolutejs/queue-adapters.git",
    "directory": "redis"
  },
  "homepage": "https://github.com/absolutejs/queue-adapters/tree/main/redis",
  "bugs": {
    "url": "https://github.com/absolutejs/queue-adapters/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Alex Kahn",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "queue",
    "jobs",
    "redis",
    "absolutejs",
    "durable",
    "worker"
  ],
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts src/manifest.ts --outdir dist --sourcemap --target=bun --external @absolutejs/queue && tsc --project tsconfig.build.json && absolute-manifest emit",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"./**/*.{ts,json,md}\"",
    "release": "bun run format && bun run build && bun publish"
  },
  "peerDependencies": {
    "@absolutejs/queue": ">=0.7.0 <0.8.0"
  },
  "devDependencies": {
    "@absolutejs/queue": "0.7.0",
    "@sinclair/typebox": "^0.34.49",
    "@types/bun": "1.3.14",
    "prettier": "3.5.3",
    "typescript": "5.8.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js",
      "default": "./dist/manifest.js"
    },
    "./manifest.json": "./dist/manifest.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "absolutejs": {
    "manifestContract": 2,
    "runtimePeers": {
      "@absolutejs/queue": {
        "artifactImports": [
          "@absolutejs/queue"
        ],
        "buildExternals": [
          "@absolutejs/queue"
        ],
        "range": ">=0.7.0 <0.8.0",
        "tested": "0.7.0"
      }
    }
  },
  "dependencies": {
    "@absolutejs/manifest": "^0.7.1",
    "@sinclair/typebox": "^0.34.0"
  }
}
