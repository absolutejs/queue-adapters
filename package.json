{
	"name": "@absolutejs/queue-adapters",
	"private": true,
	"type": "module",
	"description": "Storage adapters for @absolutejs/queue (Postgres, and more to come)",
	"workspaces": [
		"postgres"
	],
	"scripts": {
		"build": "bun run --filter './*' build",
		"test": "bun run --filter './*' test",
		"typecheck": "bun run --filter './*' typecheck",
		"format": "prettier --write \"./*/src/**/*.{ts,json,md}\" \"./*/tests/**/*.ts\""
	},
	"devDependencies": {
		"prettier": "3.5.3"
	}
}
